<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >




    <TextView
        android:id="@+id/tvGrade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Grades"
        android:textSize="18sp"
        android:textColor="#000000"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="20dp" />


    <EditText
        android:id="@+id/etStudentId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Student ID"
        android:inputType="text"
        android:layout_below="@id/tvGrade"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/btnShowGrades"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show Grades"
        android:layout_below="@id/etStudentId"
        android:layout_marginTop="20dp" />

    <!-- Table Layout to Display Schedule -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnShowGrades"
        android:layout_above="@id/btnLogout"
        android:paddingTop="20dp"
        android:fillViewport="true">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TableLayout
                android:id="@+id/tableSchedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:stretchColumns="*">

                <!-- Table Header -->
                <TableRow android:background="@color/white">
                    <TextView android:text="ID" android:padding="8dp" android:textStyle="bold"/>
                    <TextView android:text="Name" android:padding="8dp" android:textStyle="bold"/>
                    <TextView android:text="Major" android:padding="8dp" android:textStyle="bold"/>
                    <TextView android:text="Course" android:padding="8dp" android:textStyle="bold"/>
                    <TextView android:text="Grade" android:padding="8dp" android:textStyle="bold"/>
                </TableRow>



            </TableLayout>
        </HorizontalScrollView>
    </ScrollView>

    <!-- Logout Button (at the bottom) -->
    <Button
        android:id="@+id/btnLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="20dp"
        android:text="Logout"
        android:backgroundTint="#FF0000"/>

</RelativeLayout>
