<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivityAdmin">

    <Button
        android:id="@+id/btnAddAdmin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Admin"
        android:backgroundTint="#2196F3"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:layout_alignParentTop="true"/>

    <Button
        android:id="@+id/btnAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Student"
        android:layout_marginBottom="12dp"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/btnaddstudents"
        android:backgroundTint="#00796B"/>


    <Button
        android:id="@+id/btnaddstudents"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Regist Student"
        android:backgroundTint="#2196F3"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/btnAddAdmin"

        android:textSize="14sp"/>

    <!-- Table Layout to Display Schedule -->

    <!-- Logout Button (at the bottom) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/btnLogout"
        android:layout_below="@id/btnAdd"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:fillViewport="true"
        android:paddingTop="20dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TableLayout
                android:id="@+id/tableScheduleAdmin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:stretchColumns="*">

                <!-- Table Header -->
                <TableRow android:background="@color/white">

                    <TextView
                        android:padding="8dp"
                        android:text="ID"
                        android:textStyle="bold" />

                    <TextView
                        android:padding="8dp"
                        android:text="Name"
                        android:textStyle="bold" />

                    <TextView
                        android:padding="8dp"
                        android:text="Major"
                        android:textStyle="bold" />

                    <TextView
                        android:padding="8dp"
                        android:text="Course"
                        android:textStyle="bold" />

                    <TextView
                        android:padding="8dp"
                        android:text="Grade"
                        android:textStyle="bold" />

                    <TextView
                        android:padding="8dp"
                        android:text="Actions"
                        android:textStyle="bold" />
                </TableRow>

                <!-- Example Data Row -->
                <TableRow>

                    <TextView
                        android:padding="8dp"
                        android:text="1" />

                    <TextView
                        android:padding="8dp"
                        android:text="John Doe" />

                    <TextView
                        android:padding="8dp"
                        android:text="CS" />

                    <TextView
                        android:padding="8dp"
                        android:text="Android Dev" />

                    <TextView
                        android:padding="8dp"
                        android:text="A" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnEdit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Edit"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnDelete"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Delete"
                            android:textColor="@android:color/holo_red_dark"
                            android:textSize="12sp" />
                    </LinearLayout>
                </TableRow>

            </TableLayout>
        </HorizontalScrollView>
    </ScrollView>

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="20dp"
        android:text="Logout"
        android:backgroundTint="#FF0000"/>

</RelativeLayout>
